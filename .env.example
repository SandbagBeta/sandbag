# SandBag environment variables
#
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# Local values come from the Supabase CLI: run `supabase start` once, or
# `supabase status` any time afterwards, and copy the printed keys.
# `supabase status -o env` prints them in shell-friendly form.
#
# Variables prefixed NEXT_PUBLIC_ are embedded in the browser bundle by Next.js.
# Everything else is server-only. Never add a NEXT_PUBLIC_ prefix to a secret.
#
# Storage buckets are not env vars: `uploads` (private, raw scans) and
# `published` (public, QC-approved GLBs) are declared in supabase/config.toml
# and created automatically by `supabase start`.

# --- Public (safe to ship to the browser) -----------------------------------

# Supabase API URL. Local stack default; hosted: https://<project-ref>.supabase.co
# Source: `supabase status` -> "API URL"
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Anonymous key. Public by design: every table and bucket is protected by RLS,
# so this key only grants what policies allow.
# Source: `supabase status` -> "anon key" (hosted: Settings > API > anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never exposed to the client) ------------------------------

# Service-role key. BYPASSES RLS. Used only by `pnpm seed` (scripts/seed.mjs,
# which writes the demo GLB to the public `published` bucket) and trusted server
# code. Keep it out of client components, logs and commits; a test in
# src/lib/supabase guards against client-side imports.
# Source: `supabase status` -> "service_role key" (hosted: Settings > API)
SUPABASE_SERVICE_ROLE_KEY=

# Secret for the deterministic fuzzed_1km offset (ADR 001 P5, src/lib/location).
# Never add a NEXT_PUBLIC_ prefix. At least 32 characters; if it is missing or
# shorter, fuzzed areas are served as hidden (fail closed) and a warning is
# logged. Rotating it moves every fuzzed point, and old + new points together
# narrow down the real location, so set it once and keep it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LOCATION_FUZZ_SECRET=

# --- OAuth providers (server only; read by the Supabase CLI) -----------------
# Added by #14 (auth). Used only by `supabase start` through env(...) references
# in supabase/config.toml; the Next.js app never reads them. They are secrets:
# never commit real values and never add a NEXT_PUBLIC_ prefix. The Supabase CLI
# does not read .env.local, so export them in your shell (or put them in
# supabase/.env, which is git-ignored) before `supabase start`.
# Setup: README "Setting up OAuth locally". Callback URL to register with both
# providers: http://127.0.0.1:54321/auth/v1/callback
# Source: GitHub > Settings > Developer settings > OAuth Apps
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
# Source: Google Cloud Console > APIs & Services > Credentials > OAuth client ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Dev only (optional) -----------------------------------------------------

# Hosts allowed to load dev-only resources from `pnpm dev`, comma-separated.
# Needed to open the dev server from a phone on your Wi-Fi: run
# `pnpm dev -H 0.0.0.0`, put your computer's LAN IP here (e.g. 192.168.1.20),
# then browse to http://<that-ip>:3000/dev/viewer. Without it the page loads
# blank because Next.js blocks the JavaScript. Ignored by production builds.
DEV_ALLOWED_ORIGINS=
